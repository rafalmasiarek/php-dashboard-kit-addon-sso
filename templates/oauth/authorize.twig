{% extends 'layout.twig' %}

{% block content %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm">
                <div class="card-body py-5">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <h5 class="card-title">Redirecting…</h5>
                    <p class="text-muted mb-0">Authorizing access for <strong>{{ client_name|default('the application') }}</strong>.</p>
                </div>
            </div>
        </div>
    </div>
</div>

{% if redirect_url is defined %}
<meta http-equiv="refresh" content="0;url={{ redirect_url }}">
<script>window.location.href = {{ redirect_url|json_encode }};</script>
{% endif %}
{% endblock %}
