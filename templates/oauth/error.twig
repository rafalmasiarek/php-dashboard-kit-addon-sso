{% extends 'layout.twig' %}

{% block content %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Authorization Error</h5>
                </div>
                <div class="card-body">
                    <p class="mb-1"><strong>Error:</strong> <code>{{ error }}</code></p>
                    {% if error_description is defined and error_description %}
                    <p class="mb-0 text-muted">{{ error_description }}</p>
                    {% endif %}
                </div>
                <div class="card-footer">
                    <a href="{{ dash }}/" class="btn btn-sm btn-outline-secondary">Back to Dashboard</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
